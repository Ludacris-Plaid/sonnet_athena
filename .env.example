# --- Database (Supabase Postgres) ---
# From Supabase: Project Settings -> Database -> Connection string.
# Use the "Transaction pooler" URI for serverless/many-short-lived-connections,
# or "Session pooler" for a traditional long-lived backend like this one.
DATABASE_URL=postgresql+psycopg2://postgres.xxxxx:[password]@aws-0-region.pooler.supabase.com:5432/postgres

# --- Supabase ---
# From Supabase: Project Settings -> API.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Leave blank to verify tokens via JWKS (recommended, modern projects).
# Only set this if your project still uses the legacy shared HS256 secret.
SUPABASE_JWT_SECRET=
VOICE_STORAGE_BACKEND=local
SUPABASE_VOICE_BUCKET=voice-audio

# --- Hermes Agent (Nous Research) — delegated deep-work tasks ---
# Hermes runs as its own separate service, not part of this app's install.
# See app/services/hermes_agent_service.py for setup steps.
HERMES_ENABLED=false
HERMES_API_BASE_URL=
HERMES_API_KEY=
HERMES_TIMEOUT_SECONDS=300

# --- Google OAuth (Gmail + Google Calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback

# --- Microsoft OAuth (Outlook Mail + Calendar via Graph) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/integrations/microsoft/callback

# --- Slack ---
SLACK_SIGNING_SECRET=

# Web search (Search tab) — Bing's API was retired, not an option.
# "searxng" (free, self-hosted, default) | "brave" | "tavily" | "none"
WEB_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8888
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# --- DeepSeek LLM (OpenAI-compatible API) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- App ---
SECRET_KEY=change_me_to_a_random_64_char_string
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# --- Vector store ---
VECTOR_INDEX_PATH=./data/vector_index
VECTOR_META_PATH=./data/vector_meta.json

# --- Trust ladder defaults ---
TRUST_THRESHOLD_AUTONOMOUS=75
TRUST_THRESHOLD_LIMITED=40

# --- Listings data source (legitimate) ---
# Fill these in once you have a real RESO Web API / MLS IDX license.
# Until then, the "demo" source generates realistic sample data so the
# rest of the pipeline (comps, scoring, embeddings) can be built and tested.
LISTINGS_SOURCE=demo
RESO_API_BASE_URL=
RESO_API_TOKEN=

# Bridge Interactive — Zillow Group's OFFICIAL RESO-standard data program.
# Apply at bridgeinteractive.com/developers (requires MLS affiliation or
# approved-partner status). This is the legitimate path to Zillow data —
# never point this integration at an unofficial "Zillow API" wrapper.
BRIDGE_API_BASE_URL=
BRIDGE_API_TOKEN=

# ATTOM Data — licensed nationwide property/public-records provider.
# Get a key at developer.attomdata.com.
ATTOM_API_KEY=

# --- Voice (STT/TTS) ---
# STT_PROVIDER: "openai" | "none"
# TTS_PROVIDER: "openai" | "elevenlabs" | "none"
# ElevenLabs generally sounds more natural — worth it for the "friend" feel.
STT_PROVIDER=openai
TTS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VOICE_CACHE_DIR=./data/voice_cache

# --- Telephony (Twilio) — lets clients call a real number and talk to Athena ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=http://localhost:8000
